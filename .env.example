# Optional local values only. Copy into the ignored .dev.vars file.
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# AI_PROVIDER=          # optional: gemini | openrouter (default: Gemini if its key is set)
# AI_MODEL=             # optional model override for the active provider
# OPENROUTER_MODEL=     # optional, e.g. openai/gpt-4o-mini or meta-llama/llama-3.3-70b-instruct:free
# GEMINI_MODEL=         # optional, e.g. gemini-2.5-flash
# OPENROUTER_SITE_URL=  # optional, sent as HTTP-Referer for OpenRouter attribution
# OPENROUTER_APP_NAME=  # optional, sent as X-Title (default RecallForge)
